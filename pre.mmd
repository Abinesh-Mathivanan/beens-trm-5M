graph TD
    subgraph Data Pipeline
        direction LR
        A1[HuggingFace Hub<br/>sudoku-extreme.csv] --> B1(dataset/build_sudoku_dataset.py);
        B1 -- Augment & Shuffle --> C1[Processed Dataset<br/>.npy files];
        C1 --> D1(dataset/puzzle_dataset.py<br/>IterableDataset);
        D1 -- Yields Batches --> E1((Batch Data));
    end

    subgraph Model Architecture
        direction TB
        F1(models/losses.py<br/><b>ACTLossHead</b>) -- Wraps --> G1(models/recursive_reasoning/trm.py<br/><b>TRM_ACT_V1</b> - Top Level);
        G1 -- Manages & Calls --> H1(<b>TRM_Inner</b><br/>Core Recursive Logic);
        G1 -- Manages State --> I1[TRMCarry<br/>(z_H, z_L, steps, halted)];
        
        H1 -- Contains --> J1(<b>TRMModule</b>);
        J1 -- Composed of --> K1(<b>TRMBlock</b>);
        K1 -- Uses --> L1(Attention & SwiGLU);
        
        H1 -- Uses --> M1(Input<br/>CastedEmbedding);
        H1 -- Uses --> N1(Output<br/>LM Head & Q Head);
    end

    subgraph Training Orchestration
        direction TB
        O1(<b>pretrain.py</b>) -- Loads --> P1(configs/pretrain_sudoku.yaml);
        P1 -- Defines Hyperparams for --> O1;
        O1 -- Initializes --> D1;
        O1 -- Initializes --> F1;
        
        E1((Batch Data)) --> Q1{Training Loop};
        
        Q1 -- "1. Move Carry to GPU" --> R1[Forward Pass<br/>model(batch, carry)];
        R1 -- "Outputs new_carry, loss, metrics" --> S1[Backward Pass<br/>loss.backward()];
        S1 -- "Computes Gradients" --> T1[Optimizer Step<br/>optimizer.step()];
        T1 -- "Updates Model Weights" --> U1["2. Move Carry to CPU<br/>(Memory Optimization)"];
        U1 -- "Loops with next batch" --> Q1;
    end
    
    %% Styling - Using colors from the AIME 2025 Chart
    classDef dataStyle fill:#BDC3C7,stroke:#333,stroke-width:2px;
    classDef scriptStyle fill:#A5D6A7,stroke:#333,stroke-width:2px,rx:5px,ry:5px;
    classDef modelStyle fill:#D7CCC8,stroke:#d35400,stroke-width:2px,rx:5px,ry:5px;
    classDef loopStyle fill:#FFE082,stroke:#f39c12,stroke-width:2px,rx:15px,ry:15px;

    class A1,C1,E1,I1 dataStyle;
    class B1,D1,O1 scriptStyle;
    class F1,G1,H1,J1,K1,L1,M1,N1 modelStyle;
    class Q1,R1,S1,T1,U1 loopStyle;